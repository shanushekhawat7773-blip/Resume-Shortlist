# ==============================================================================
# RESUME SHORTLIST — Enterprise Configuration Template
# ==============================================================================

# Core Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL with SQLite fallback)
# Primary Production: postgresql+asyncpg://user:password@localhost:5432/resume_shortlist
DATABASE_URL=sqlite+aiosqlite:///./resume_shortlist.db

# Security & Cryptography
SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Network Access
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# File Processing & Safety Constraints
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=["pdf","docx","txt"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Scoring Engine Defaults (Must sum to 100)
WEIGHT_REQUIRED_SKILLS=30
WEIGHT_EXPERIENCE_RELEVANCE=20
WEIGHT_RESPONSIBILITIES=20
WEIGHT_EDUCATION=10
WEIGHT_PREFERRED_SKILLS=10
WEIGHT_PROJECTS=10
